<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Customer Header Container Style -->
    <style name="CustomerHeaderContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/customer_header_banner_height</item>
    </style>

    <!-- Customer Header Card Style -->
    <style name="CustomerHeaderCard" parent="@style/Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginTop">@dimen/customer_header_banner_margin_top</item>
        <item name="android:layout_marginHorizontal">@dimen/customer_header_card_horizontal_padding</item>
        <item name="android:clipToPadding">false</item>
        <item name="cardBackgroundColor">@color/customer_header_card_background</item>
        <item name="cardElevation">@dimen/customer_header_card_elevation</item>
        <item name="cardCornerRadius">@dimen/customer_header_card_radius</item>
    </style>

    <!-- Customer Header Image Style -->
    <style name="CustomerHeaderImage">
        <item name="android:layout_width">@dimen/customer_header_image_width</item>
        <item name="android:layout_height">@dimen/customer_header_image_height</item>
        <item name="android:layout_marginTop">@dimen/customer_header_image_margin_top</item>
        <item name="android:layout_marginStart">@dimen/customer_header_image_margin_start</item>
        <item name="android:scaleType">fitStart</item>
        <item name="android:tint">@color/customer_header_image_tint</item>
    </style>

    <!-- Customer Header Text Style -->
    <style name="CustomerHeaderText" parent="@android:style/TextAppearance.DeviceDefault.Large">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">end|center</item>
        <item name="android:paddingTop">@dimen/customer_header_text_padding_top</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
        <item name="android:textSize">@dimen/customer_header_text_size</item>
        <item name="android:fontFamily">@font/Poppins-ExtraBoldItalic</item>
        <item name="android:letterSpacing">@dimen/customer_header_text_letter_spacing</item>
    </style>

</resources>

