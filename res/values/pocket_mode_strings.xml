<resources>
    <!-- Pocket Mode Page -->
    <string name="pocket_mode_title">Pocket Mode</string>
    <string name="pocket_mode_intro_title">Prevent Accidental Touches</string>
    <string name="pocket_mode_intro_summary">Configure pocket mode to prevent accidental screen touches, unlocks, and wake gestures when your device is in a pocket or bag. Uses proximity sensor and other sensors to detect when device is covered.</string>

    <!-- Categories -->
    <string name="pocket_mode_main_category">Pocket Mode</string>
    <string name="pocket_mode_advanced_category">Advanced Options</string>

    <!-- Pocket Lock -->
    <string name="pocket_lock_title">Pocket Lock</string>
    <string name="pocket_lock_summary">Prevent accidental touches when device is in pocket or bag using proximity sensor</string>
    
    <!-- Always-on Pocket Mode -->
    <string name="always_on_pocket_mode_title">Always-on Pocket Mode</string>
    <string name="always_on_pocket_mode_summary">Keep pocket mode active even when screen is on. Provides continuous protection against accidental touches</string>
    
    <!-- Disable Double Tap to Wake -->
    <string name="pocket_mode_disable_dt2w_title">Disable double tap to wake</string>
    <string name="pocket_mode_disable_dt2w_summary">Prevent screen from waking when double tapped while device is in pocket</string>
    
    <!-- Disable Fingerprint Sensor -->
    <string name="pocket_mode_disable_fingerprint_title">Disable fingerprint sensor</string>
    <string name="pocket_mode_disable_fingerprint_summary">Prevent fingerprint authentication when device is in pocket to avoid accidental unlocks</string>
    
    <!-- Disable Lift to Wake -->
    <string name="pocket_mode_disable_lift_to_wake_title">Disable lift to wake</string>
    <string name="pocket_mode_disable_lift_to_wake_summary">Prevent screen from waking when device is lifted while in pocket</string>
</resources>

