<resources>
    <!-- Monet color resources - following system color patterns -->

    <!-- Preset text colors -->
    <color name="monet_preset_text_color">?android:attr/textColorPrimary</color>
    <color name="monet_preset_text_color_secondary">?android:attr/textColorSecondary</color>

    <!-- Preset card background - using system surface colors -->
    <color name="monet_preset_card_background">?android:attr/colorBackground</color>
    <color name="monet_preset_card_stroke">?android:attr/colorPrimary</color>

    <!-- Status colors for feedback -->
    <color name="monet_status_success">#4CAF50</color>
    <color name="monet_status_info">#2196F3</color>
    <color name="monet_status_warning">#FF9800</color>
    <color name="monet_status_error">#F44336</color>

    <!-- Overlay colors for better contrast -->
    <color name="monet_overlay_light">#80FFFFFF</color>
    <color name="monet_overlay_dark">#80000000</color>

    <!-- Default fallback colors using system color references -->
    <color name="monet_fallback_primary">?android:attr/colorPrimary</color>
    <color name="monet_fallback_secondary">?android:attr/colorSecondary</color>
    <color name="monet_fallback_tertiary">?android:attr/colorAccent</color>
    <color name="monet_fallback_neutral">?android:attr/colorBackground</color>

    <!-- Gradient preview background -->
    <color name="monet_gradient_preview_bg">?android:attr/colorBackground</color>

    <!-- Time slot indicator colors -->
    <color name="monet_time_dawn">#FFF8E1</color>
    <color name="monet_time_morning">#E3F2FD</color>
    <color name="monet_time_afternoon">#FFF3E0</color>
    <color name="monet_time_evening">#FCE4EC</color>
    <color name="monet_time_night">#0D1B2A</color>
</resources>
