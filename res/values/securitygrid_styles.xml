<resources>
    <style name="securitygrid_text_primary">
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamily</item>
    </style>
    <style name="securitygrid_text_secondary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
    <style name="securitygrid_clock">
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">56sp</item>
        <item name="android:textColor">@color/securitygrid_clock_color</item>
        <item name="android:fontFeatureSettings">tnum, cv03, cv04</item>
    </style>
