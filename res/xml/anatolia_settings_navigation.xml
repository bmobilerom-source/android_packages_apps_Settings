<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
	android:title="@string/navbar_title">
 
   <Preference
            android:key="virtual_keyboard_pref"
            android:title="@string/keyboard_settings"
            android:summary="@string/keyboard_settings_summary"
            android:fragment="com.android.settings.inputmethod.VirtualKeyboardFragment"
            settings:keywords="@string/keywords_virtual_keyboard"
            settings:layout="@layout/preference_card"/>

   <!-- Test XD Card Middle -->
   <Preference
            android:key="test_card_mid"
            android:title="Test Card Middle"
            android:summary="XD Middle Card"
            settings:layout="@layout/preference_card"/>

   <!-- Test XD Card Bottom -->
  <Preference
            android:key="test_card_bot"
            android:title="Test Card Bottom"
            android:summary="XD Bottom Card"
            settings:layout="@layout/preference_card"/>

   <!-- Test DOT Card Top -->
   <Preference
            android:key="test_dot_top"
            android:title="Aosp Top Card"
            android:summary="Aosp Top Card"
            settings:layout="@layout/preference_card_aosp_top"/>

   <!-- Test AfterLife Card Top -->
   <Preference
            android:key="test_afterlife"
            android:title="wi with arrow top card"
            android:summary="with arrow top card"
            settings:layout="@layout/preference_card_witharrow_top"/>

   <!-- Test Top Level Top Card -->
   <Preference
            android:key="test_top_level_top"
            android:title="Main Card"
            android:summary="Main Card"
            settings:layout="@layout/preference_card_main"/>

   <!-- Test Top Level Solo Card -->
   <Preference
            android:key="test_top_level_solo"
            android:title="Solo Card"
            android:summary="Solo Card"
            settings:layout="@layout/preference_card_aosp_solo"/>

   <!-- Test Top Level Middle Card -->
   <Preference
            android:key="test_top_level_middle"
            android:title="Test Top Level Middle"
            android:summary="Top Level Middle Card"
            settings:layout="@layout/top_level_preference_middle_card"/>

   <!-- Test AfterLife Homepage Top -->
   <Preference
            android:key="test_afterlife_homepage_top"
            android:title="Test AfterLife Homepage"
            android:summary="AfterLife Homepage Card"
            settings:layout="@layout/afterlife_card_homepage_top"/>

   <!-- Test AfterLife Homepage Middle -->
   <Preference
            android:key="test_afterlife_homepage_middle"
            android:title="Test AfterLife Homepage Middle"
            android:summary="AfterLife Homepage Middle Card"
            settings:layout="@layout/afterlife_card_homepage_middle"/>

   <!-- System Midsize Preference Card -->
   <Preference
            android:key="systemmidsize_preference_card"
            android:title="System Midsize Preference Card"
            android:summary="System Midsize Preference Card"
            settings:layout="@layout/systemmidsize_preference_card"/>

   <!-- Test DOT Card Middle -->
   <Preference
            android:key="test_dot_middle"
            android:title="Test DOT Middle"
            android:summary="DOT Middle Card"
            settings:layout="@layout/dot_preference_middle_card"/>

   <!-- Test DOT Card Bottom -->
   <Preference
            android:key="test_dot_bottom"
            android:title="Test DOT Bottom"
            android:summary="DOT Bottom Card"
            settings:layout="@layout/dot_preference_bottom_card"/>

   <!-- Test AfterLife Middle -->
   <Preference
            android:key="test_afterlife_middle"
            android:title="Test AfterLife Middle"
            android:summary="AfterLife Middle Card"
            settings:layout="@layout/afterlife_cardview_middle"/>

   <!-- Test AfterLife Bottom -->
   <Preference
            android:key="test_afterlife_bottom"
            android:title="Test AfterLife Bottom"
            android:summary="AfterLife Bottom Card"
            settings:layout="@layout/afterlife_cardview_bottom"/>

   <!-- Test Top Level Bottom -->
   <Preference
            android:key="test_top_level_bottom"
            android:title="Test Top Level Bottom"
            android:summary="Top Level Bottom Card"
            settings:layout="@layout/top_level_preference_bottom_card"/>

   <!-- Test AfterLife Single Left -->
   <Preference
            android:key="test_afterlife_single_left"
            android:title="Test AfterLife Single Left"
            android:summary="AfterLife Single Left Card"
            settings:layout="@layout/afterlife_cardview_single_left"/>
<Preference
    android:title="Help Title"
    android:summary="Help summary text"
    settings:layout="@layout/system_help_preference_card" />
   <!-- Test AfterLife Single Right -->
   <Preference
            android:key="test_afterlife_single_right"
            android:title="Test AfterLife Single Right"
            android:summary="AfterLife Single Right Card"
            settings:layout="@layout/afterlife_cardview_single_right"/>

   <!-- Test AfterLife Homepage Bottom -->
   <Preference
            android:key="test_afterlife_homepage_bottom"
            android:title="Test AfterLife Homepage Bottom"
            android:summary="AfterLife Homepage Bottom Card"
            settings:layout="@layout/afterlife_card_homepage_bottom"/>
</PreferenceScreen>
