        settings:isPreferenceVisible="@bool/config_show_emergency_settings"
        settings:highlightableMenuKey="@string/menu_key_emergency"/>
    -->

    <!-- System + YR Custom Dashboard -->
    <com.android.settings.widget.HomepagePreference
        android:fragment="com.bmobile.fragments.YrCustomDashboardSettings"
        android:icon="@drawable/ic_custom_dashboard"
        android:key="top_level_yr_custom_dashboard"
        android:order="15"
        android:title="@string/yr_custom_dashboard_title"
        android:summary="@string/yr_custom_dashboard_summary"
        settings:highlightableMenuKey="@string/menu_key_system"/>

