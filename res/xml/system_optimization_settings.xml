<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/system_optimization_title">

    <!-- Lottie Animation -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="system_optimization_illustration"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/optimise" />

 
    <!-- Status Summary -->
    <Preference
        android:key="optimization_status"
        android:title="@string/optimization_status_title"
        android:summary="@string/optimization_status_summary"
        android:selectable="false"
        android:order="-990"
        settings:controller="com.bmobile.fragments.OptimizationStatusController"
        settings:searchable="false"
        settings:layout="@layout/adaptive_preference_card" />

    <!-- Optimization Preferences -->
    <!-- Only features that work out of the box without kernel/framework changes -->
    
    <SwitchPreference
        android:key="background_app_limits"
        android:title="@string/background_app_limits_title"
        android:summary="@string/background_app_limits_summary"
        android:defaultValue="false"
        settings:controller="com.bmobile.fragments.BackgroundAppLimitsController"
        settings:searchable="false" />

    <SwitchPreference
        android:key="network_optimization"
        android:title="@string/network_optimization_title"
        android:summary="@string/network_optimization_summary"
        android:defaultValue="false"
        settings:controller="com.bmobile.fragments.NetworkOptimizationController"
        settings:searchable="false" />

    <SwitchPreference
        android:key="battery_optimization"
        android:title="@string/battery_optimization_title"
        android:summary="@string/battery_optimization_summary"
        android:defaultValue="false"
        settings:controller="com.bmobile.fragments.BatteryOptimizationController"
        settings:searchable="false" />

    <SwitchPreference
        android:key="storage_optimization"
        android:title="@string/storage_optimization_title"
        android:summary="@string/storage_optimization_summary"
        android:defaultValue="false"
        settings:controller="com.bmobile.fragments.StorageOptimizationController"
        settings:searchable="false" />

    <SwitchPreference
        android:key="thermal_throttling"
        android:title="@string/thermal_throttling_title"
        android:summary="@string/thermal_throttling_summary"
        android:defaultValue="false"
        settings:controller="com.bmobile.fragments.ThermalThrottlingController"
        settings:searchable="false" />


</PreferenceScreen>
