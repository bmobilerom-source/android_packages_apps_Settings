<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="security_dashboard_page"
    android:title=" ">

    <!-- Illustration -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="security"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/security"/> 

    <!-- Header -->
    <PreferenceCategory
        android:title="@string/security_settings_title"
        android:order="-1000"
        android:layout="@layout/settings_title_header_small"
        settings:searchable="false">
    </PreferenceCategory>

    <!-- TopIntro -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="security_dashboard_top_intro"
        android:title="@string/security_settings_title"
        android:persistent="false"
        android:order="-999"
        settings:searchable="false"/>

    <!-- Footer -->
    <com.android.settingslib.widget.FooterPreference
        android:key="security_dashboard_footer"
        android:order="-998"
        settings:searchable="false" />
        
    <!-- security_settings_status.xml -->
    <PreferenceCategory
        android:order="0"
        android:key="security_status"
        android:title="@string/security_status_title"
        settings:searchable="false" />

    <PreferenceCategory
        android:order="1"
        android:key="dashboard_tile_placeholder"
        settings:searchable="false" />

    <!-- security section -->
    <PreferenceCategory
        android:order="2"
        android:key="security_category"
        android:title="@string/lock_settings_title"
        settings:searchable="false">

        <!-- Choose screen lock - Commented out
        <com.android.settings.widget.GearPreference
            android:key="unlock_set_or_change"
            android:title="@string/unlock_set_unlock_launch_picker_title"
            android:summary="@string/summary_placeholder"
            android:order="0"
            settings:keywords="@string/keywords_lockscreen" />
        -->

        <!-- Default fingerprint settings hidden - using BMobile fingerprint instead -->
        <com.android.settingslib.RestrictedPreference
            android:key="fingerprint_settings"
            android:title="@string/security_settings_fingerprint_preference_title"
            android:summary="@string/summary_placeholder"
            android:order="1"
            android:visible="false"
            settings:keywords="@string/keywords_fingerprint_settings"
            settings:searchable="false" />
        
        <!-- BMobile Fingerprint Implementation -->
        <Preference
            android:key="bmobile_fingerprint_settings"
            android:title="@string/bmobile_fingerprint_title"
            android:summary="@string/bmobile_fingerprint_summary"
            android:fragment="com.epic.fragments.BMobileFingerprintSettings"
            android:order="1"
            settings:layout="@layout/system_warning_preference_card"
            settings:searchable="false" />

        <com.android.settingslib.RestrictedPreference
            android:key="face_settings"
            android:title="@string/security_settings_face_preference_title"
            android:summary="@string/summary_placeholder"
            android:order="2"
            settings:keywords="@string/keywords_face_settings"
            settings:searchable="false" />

        <com.android.settingslib.RestrictedPreference
            android:key="biometric_settings"
            android:title="@string/security_settings_biometric_preference_title"
            android:summary="@string/summary_placeholder"
            android:order="3"
            settings:keywords="@string/keywords_biometric_settings"
            settings:searchable="false" />
    </PreferenceCategory>

    <Preference
        android:order="4"
        android:key="security_advanced_settings"
        android:title="@string/security_advanced_settings"
        android:summary="@string/summary_placeholder"
        settings:layout="@layout/system_warning_preference_card"        
        android:fragment="com.android.settings.security.SecurityAdvancedSettings"
        settings:controller="com.android.settings.security.SecurityAdvancedSettingsController"
        settings:keywords="@string/security_advanced_settings_keywords"
        settings:searchable="false" />

</PreferenceScreen>
