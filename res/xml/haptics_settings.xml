<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/haptics_settings_title">

    <!-- Haptics illustration -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="haptics_illustration"
        android:order="-1001"
        settings:searchable="false"
        app:lottie_rawRes="@raw/sound" />

    <!-- Back gesture haptics intensity -->
    <com.android.settings.preferences.ui.AdaptiveListPreference
        android:key="back_gesture_haptics_intensity"
        android:title="@string/back_gesture_haptics_intensity_title"
        android:entries="@array/haptics_intensity_entries"
        android:entryValues="@array/haptics_intensity_values"
        android:defaultValue="1"
        android:persistent="false"
        android:order="0"
        app:position="top"
        settings:keywords="back gesture, haptics, vibration, intensity" />

    <!-- Brightness slider haptics intensity -->
    <com.android.settings.preferences.ui.AdaptiveListPreference
        android:key="brightness_slider_haptics_intensity"
        android:title="@string/brightness_slider_haptics_intensity_title"
        android:entries="@array/haptics_intensity_entries"
        android:entryValues="@array/haptics_intensity_values"
        android:defaultValue="0"
        android:persistent="false"
        android:order="10"
        app:position="middle"
        settings:keywords="brightness slider, haptics, vibration, intensity" />

    <!-- Volume slider haptics intensity -->
    <com.android.settings.preferences.ui.AdaptiveListPreference
        android:key="volume_slider_haptics_intensity"
        android:title="@string/volume_slider_haptics_intensity_title"
        android:entries="@array/haptics_intensity_entries"
        android:entryValues="@array/haptics_intensity_values"
        android:defaultValue="1"
        android:persistent="false"
        android:order="20"
        app:position="bottom"
        settings:keywords="volume slider, haptics, vibration, intensity" />

</PreferenceScreen>
