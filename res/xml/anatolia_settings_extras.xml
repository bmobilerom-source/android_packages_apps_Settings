<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
	android:title="@string/extras_title">

    <!-- Security &amp; Privacy Features Header -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="security_privacy_intro"
        android:order="-1000"
        android:title="@string/security_privacy_intro_title"
        android:summary="@string/security_privacy_intro_summary"
        android:persistent="false"
        settings:searchable="false" />

    <!-- Core Security Controls -->
    <PreferenceCategory
        android:title="@string/security_features_category_access_control"
        android:key="core_security_category">

        <Preference
            android:key="security_features_status"
            android:title="Security Features Status"
            android:summary="View current security settings and status"
            android:fragment="com.epic.fragments.SecurityFeaturesSettings"
            android:icon="@drawable/ic_security" />

    </PreferenceCategory>

    <!-- Developer &amp; USB Security -->
    <PreferenceCategory
        android:title="Developer &amp; USB Security"
        android:key="developer_usb_category">

        <SwitchPreference
            android:key="usb_debugging"
            android:title="@string/usb_debugging_title"
            android:summary="@string/usb_debugging_summary"
            android:defaultValue="false"
            settings:controller="com.epic.fragments.UsbDebuggingController" />

        <SwitchPreference
            android:key="developer_options"
            android:title="@string/developer_options_title"
            android:summary="@string/developer_options_summary"
            android:defaultValue="true"
            settings:controller="com.epic.fragments.DeveloperOptionsController" />

    </PreferenceCategory>

    <!-- Lock Screen &amp; Biometric Security -->
    <PreferenceCategory
        android:title="Lock Screen &amp; Biometric Security"
        android:key="lock_biometric_category">

        <SwitchPreference
            android:key="biometric_timeout"
            android:title="@string/biometric_timeout_title"
            android:summary="@string/biometric_timeout_summary"
            android:defaultValue="true"
            settings:controller="com.epic.fragments.BiometricTimeoutController" />

    </PreferenceCategory>


</PreferenceScreen>
