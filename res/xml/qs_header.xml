<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/qs_header_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="qs_header_illustration"
        android:order="-1001"
        settings:searchable="false"
        app:lottie_rawRes="@raw/display" />

    <!-- Hidden: custom header stays enabled; toggle not shown in UI. -->
    <SwitchPreferenceCompat
        android:key="qs_header_enable"
        android:title="@string/qs_header_enable_title"
        android:summary="@string/qs_header_enable_summary"
        android:defaultValue="true"
        android:order="-999"
        settings:searchable="false" />

    <PreferenceCategory
        android:key="qs_header_image_category"
        android:title="@string/qs_header_image_category"
        android:order="0">

        <Preference
            android:key="qs_header_image_gallery"
            android:title="@string/qs_header_provider_gallery"
            android:summary="@string/qs_header_image_summary"
            android:order="0"
            settings:layout="@layout/adaptive_preference_card" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="qs_header_appearance_category"
        android:title="@string/qs_header_appearance_category"
        android:order="1">

        <com.android.settings.widget.SeekBarPreference
            android:key="qs_header_height"
            android:title="@string/qs_header_height_title"
            android:summary="@string/qs_header_height_summary"
            android:defaultValue="142"
            android:min="80"
            android:max="260"
            android:order="0" />

        <!-- Developer: shadow fade hidden until QS header fade UX is finalized.
        <com.android.settings.widget.SeekBarPreference
            android:key="qs_header_shadow"
            android:title="@string/qs_header_shadow_title"
            android:summary="@string/qs_header_shadow_summary"
            android:defaultValue="0"
            android:min="0"
            android:max="255"
            android:order="1" />
        -->

    </PreferenceCategory>

</PreferenceScreen>
