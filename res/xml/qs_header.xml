<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/qs_header_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="qs_header_illustration"
        android:order="-1001"
        settings:searchable="false"
        app:lottie_rawRes="@raw/display" />

    <com.android.settingslib.widget.TopIntroPreference
        android:key="qs_header_intro"
        android:title="@string/qs_header_title"
        android:summary="@string/qs_header_summary"
        android:order="-1000" />

    <!-- Custom Header File Picker -->
    <Preference
        android:key="qs_header_custom_file"
        android:title="@string/qs_header_file_picker_title"
        android:summary="@string/qs_header_file_picker_summary"
        android:order="-1"
        app:position="top" />

    <!-- QS Header Selection -->
    <com.android.settings.preferences.ui.AdaptiveListPreference
        android:key="qs_header_image"
        android:title="@string/qs_header_image_title"
        android:summary="@string/qs_header_image_summary"
        android:entries="@array/anciui_header_img_entries"
        android:entryValues="@array/anciui_header_img_values"
        android:defaultValue="com.android.systemui/qs_header_image_0"
        android:order="0"
        app:position="middle" />

    <!-- QS Header Shadow / Brightness -->
    <com.android.settings.preferences.ui.AdaptiveListPreference
        android:key="qs_header_shadow"
        android:title="@string/qs_header_shadow_title"
        android:summary="@string/qs_header_shadow_summary"
        android:entries="@array/qs_header_shadow_entries"
        android:entryValues="@array/qs_header_shadow_values"
        android:defaultValue="1"
        android:order="10"
        app:position="middle" />

    <!-- Header Height (Length) -->
    <com.android.settings.preferences.ui.AdaptiveListPreference
        android:key="qs_header_height"
        android:title="@string/qs_header_height_title"
        android:summary="@string/qs_header_height_summary"
        android:entries="@array/qs_header_height_entries"
        android:entryValues="@array/qs_header_height_values"
        android:defaultValue="142"
        android:order="20"
        app:position="bottom" />

</PreferenceScreen>

