<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title=" ">


    <com.android.settingslib.widget.IllustrationPreference
        android:key="apps_illustration_video"
        settings:searchable="false"
        android:order="-1000"
        settings:lottie_rawRes="@raw/app_illustration"/>

 
    <Preference
        android:key="all_app_infos"
        android:title="@string/all_apps"
        android:summary="@string/summary_placeholder"
        android:order="-999"
        android:fragment="com.android.settings.applications.manageapplications.ManageApplications"
        settings:keywords="@string/keywords_applications_settings"
        settings:layout="@layout/adaptive_preference_card"/>
 
  
    <PreferenceCategory
        android:key="general_category"
        android:title="@string/category_name_general"
        android:order="-997"
        android:visibility="gone"
        settings:searchable="false"/>

    <Preference
        android:key="default_apps"
        android:title="@string/app_default_dashboard_title"
        android:order="-996"
        settings:controller="com.android.settings.applications.DefaultAppsPreferenceController"
        settings:layout="@layout/adaptive_preference_card_top"/>


    <Preference
        android:key="hibernated_apps"
        android:title="@string/unused_apps"
        android:summary="@string/summary_placeholder"
        android:order="15"
        settings:keywords="app_hibernation_key"
        settings:controller="com.android.settings.applications.HibernatedAppsPreferenceController"
        settings:layout="@layout/adaptive_preference_card_middle"/>

    <Preference
        android:key="app_battery_usage"
        android:order="17"
        android:title="@string/app_battery_usage_title"
        android:summary="@string/app_battery_usage_summary"
        settings:controller="com.android.settings.applications.AppBatteryUsagePreferenceController"
        settings:layout="@layout/adaptive_preference_card_middle"
        android:fragment="com.android.settings.applications.manageapplications.ManageApplications">
        <extra
            android:name="classname"
            android:value="com.android.settings.Settings$AppBatteryUsageActivity"/>
    </Preference>

    <Preference
        android:key="special_access"
        android:fragment="com.android.settings.applications.specialaccess.SpecialAccessSettings"
        android:title="@string/special_access"
        android:order="20"
        settings:layout="@layout/adaptive_preference_card_bottom">
    </Preference>


        <!-- Native Alpha Browser (dynamically shown if installed) -->
        <Preference
            android:key="native_alpha_pref"
            android:title="Native Alpha"
            android:summary="Open Native Alpha browser settings"
            android:order="28"
            settings:controller="com.android.settings.applications.NativeAlphaPreferenceController"
            settings:layout="@layout/system_features_preference_card">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.cylonid.nativealpha"
                android:targetClass="com.cylonid.nativealpha.MainActivity" />
        </Preference>

        <!-- DigPaws (dynamically shown if installed) -->
        <Preference
            android:key="digpaws_pref"
            android:title="DigPaws"
            android:summary="Open DigPaws settings"
            android:order="29"
            settings:controller="com.android.settings.applications.DigPawsPreferenceController"
            settings:layout="@layout/system_features_preference_card">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="nethical.digipaws"
                android:targetClass="nethical.digipaws.ui.activity.MainActivity" />
        </Preference>

        <!-- System Launch Pad (dynamically shown if installed) -->
        <Preference
            android:key="system_launchpad_pref"
            android:title="System Launch Pad"
            android:summary="Quick search for online and system"
            android:order="30"
            settings:controller="com.android.settings.applications.SystemLaunchPadPreferenceController"
            settings:layout="@layout/system_features_preference_card">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.devrinth.launchpad"
                android:targetClass="com.devrinth.launchpad.activities.SettingsActivity" />
        </Preference>
      
    <!-- Sidebar App (dynamically shown if installed) -->
    <Preference
        android:key="sidebar_pref"
        android:title="Sidebar"
        android:summary="Access sidebar features"
        android:order="40"
        settings:layout="@layout/system_features_preference_card"
        settings:controller="com.android.settings.applications.SidebarPreferenceController">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.libremobileos.sidebar"
            android:targetClass="com.libremobileos.sidebar.ui.sidebar.SidebarSettingsActivity" />
    </Preference>
</PreferenceScreen>

