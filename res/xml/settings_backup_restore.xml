<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/settings_backup_restore_title">

    <!-- Lottie Illustration -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="settings_backup_illustration"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/backup_settings" />

    <!-- Top Intro -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="settings_backup_intro"
        android:order="-1000"
        android:title="@string/settings_backup_restore_intro_title"
        android:summary="@string/settings_backup_restore_intro_summary"
        android:persistent="false" />

    <PreferenceCategory
        android:title="@string/settings_backup_restore_category_title"
        android:key="settings_backup_category">

        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="backup_settings"
            android:title="@string/settings_backup_title"
            android:summary="@string/settings_backup_summary"
            android:icon="@drawable/ic_settings_backup_restore"
            app:position="top" />

        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="restore_settings"
            android:title="@string/settings_restore_title"
            android:summary="@string/settings_restore_summary"
            android:icon="@drawable/ic_restore"
            app:position="bottom" />

    </PreferenceCategory>

</PreferenceScreen>

