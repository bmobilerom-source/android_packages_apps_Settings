<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="apps_screen"
    android:title="@string/apps_dashboard_title">


    <com.android.settingslib.widget.IllustrationPreference
        android:key="apps_illustration_video"
        settings:searchable="false"
        android:order="-1000"
        settings:lottie_rawRes="@raw/bmobilesettings"/>

    <!-- Hidden: All Apps preference - commented out -->
    <!--
    <Preference
        android:key="all_app_infos"
        android:title="@string/all_apps"
        android:summary="@string/summary_placeholder"
        android:order="-999"
        android:fragment="com.android.settings.applications.manageapplications.ManageApplications"
        settings:keywords="@string/keywords_applications_settings"
        settings:layout="@layout/adaptive_preference_card"/>
    -->

    <PreferenceCategory
        android:key="recent_apps_category"
        android:title="@string/recent_app_category_title"
        android:order="-998"
        settings:isPreferenceVisible="false"
        settings:searchable="false">
        <!-- Placeholder for a list of recent apps -->

        <!-- See all apps -->
        <Preference
            android:key="see_all_apps"
            android:title="@string/default_see_all_apps_title"
            android:icon="@drawable/ic_chevron_right_24dp"
            android:fragment="com.android.settings.applications.manageapplications.ManageApplications"
            android:order="5"
            settings:searchable="false"
            settings:layout="@layout/adaptive_preference_card" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="general_category"
        android:title="@string/category_name_general"
        android:order="-997"
        android:visibility="gone"
        settings:searchable="false"/>

    <Preference
        android:key="default_apps"
        android:title="@string/app_default_dashboard_title"
        android:order="-996"
        settings:controller="com.android.settings.applications.DefaultAppsPreferenceController"
        settings:layout="@layout/adaptive_preference_card"/>

    <Preference
        android:key="cloned_apps"
        android:title="@string/cloned_apps_dashboard_title"
        android:summary="@string/summary_placeholder"
        android:order="-995"
        settings:controller="com.android.settings.applications.ClonedAppsPreferenceController"
        android:fragment="com.android.settings.applications.manageapplications.ManageApplications">
        <extra
            android:name="classname"
            android:value="com.android.settings.Settings$ClonedAppsListActivity"/>
        <intent
            android:action="android.settings.MANAGE_CLONED_APPS_SETTINGS"
            android:targetPackage="${applicationId}"/>
    </Preference>

    <PreferenceCategory
        android:key="dashboard_tile_placeholder"
        android:order="10"/>

    <Preference
        android:key="contacts_storage"
        android:title="@string/contacts_storage_settings_title"
        android:summary="@string/summary_placeholder"
        android:order="13"
        settings:controller="com.android.settings.applications.contacts.ContactsStoragePreferenceController"
        android:fragment="com.android.settings.applications.contacts.ContactsStorageSettings"
        settings:keywords="@string/keywords_contacts_storage">
    </Preference>

    <Preference
        android:key="hibernated_apps"
        android:title="@string/unused_apps"
        android:summary="@string/summary_placeholder"
        android:order="15"
        settings:keywords="app_hibernation_key"
        settings:controller="com.android.settings.applications.HibernatedAppsPreferenceController"
        settings:layout="@layout/adaptive_preference_card_middle"/>

    <Preference
        android:key="app_battery_usage"
        android:order="17"
        android:title="@string/app_battery_usage_title"
        android:summary="@string/app_battery_usage_summary"
        settings:controller="com.android.settings.applications.AppBatteryUsagePreferenceController"
        settings:layout="@layout/adaptive_preference_card_middle"
        android:fragment="com.android.settings.applications.manageapplications.ManageApplications">
        <extra
            android:name="classname"
            android:value="com.android.settings.Settings$AppBatteryUsageActivity"/>
    </Preference>

    <Preference
        android:key="special_access"
        android:fragment="com.android.settings.applications.specialaccess.SpecialAccessSettings"
        android:title="@string/special_access"
        android:order="20"
        settings:layout="@layout/adaptive_preference_card_middle">
    </Preference>

    <PreferenceCategory
        android:key="advanced_category"
        android:title="@string/advanced_apps"
        android:order="21"
        settings:searchable="false">

        <Preference
            android:key="aspect_ratio_apps"
            android:title="@string/aspect_ratio_experimental_title"
            android:summary="@string/summary_placeholder"
            android:order="22"
            settings:controller="com.android.settings.applications.appcompat.UserAspectRatioAppsPreferenceController"
            settings:layout="@layout/adaptive_preference_card"
            android:fragment="com.android.settings.applications.manageapplications.ManageApplications">
            <extra android:name="classname"
                   android:value="com.android.settings.Settings$UserAspectRatioAppListActivity"/>
            <intent android:action="android.settings.MANAGE_USER_ASPECT_RATIO_SETTINGS"/>
        </Preference>

    </PreferenceCategory>

        <!-- Sidebar App (dynamically shown if installed) -->
        <Preference
            android:key="sidebar_pref"
            android:title="Sidebar"
            android:summary="Access sidebar features"
            android:order="26"
            settings:controller="com.android.settings.applications.SidebarPreferenceController"
            settings:layout="@layout/adaptive_preference_card_middle">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.libremobileos.sidebar"
                android:targetClass="com.libremobileos.sidebar.ui.sidebar.SidebarSettingsActivity" />
        </Preference>

        <!-- Files/Cloud Media App (dynamically shown if installed) -->
        <Preference
            android:key="files_app_pref"
            android:title="Files"
            android:summary="Access cloud media and file management"
            android:order="27"
            settings:controller="com.android.settings.applications.CloudMediaPreferenceController"
            settings:layout="@layout/adaptive_preference_card_middle">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.android.documentsui"
                android:targetClass="com.android.documentsui.DocumentsActivity" />
        </Preference>

        <!-- Native Alpha Browser (dynamically shown if installed) -->
        <Preference
            android:key="native_alpha_pref"
            android:title="Native Alpha"
            android:summary="Open Native Alpha browser settings"
            android:order="28"
            settings:controller="com.android.settings.applications.NativeAlphaPreferenceController"
            settings:layout="@layout/adaptive_preference_card_middle">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.cylonid.nativealpha"
                android:targetClass="com.cylonid.nativealpha.MainActivity" />
        </Preference>

        <!-- DigPaws (dynamically shown if installed) -->
        <Preference
            android:key="digpaws_pref"
            android:title="DigPaws"
            android:summary="Open DigPaws settings"
            android:order="29"
            settings:controller="com.android.settings.applications.DigPawsPreferenceController"
            settings:layout="@layout/adaptive_preference_card_middle">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="nethical.digipaws"
                android:targetClass="nethical.digipaws.ui.activity.MainActivity" />
        </Preference>

        <!-- System Launch Pad (dynamically shown if installed) -->
        <Preference
            android:key="system_launchpad_pref"
            android:title="System Launch Pad"
            android:summary="Quick search for online and system"
            android:order="30"
            settings:controller="com.android.settings.applications.SystemLaunchPadPreferenceController"
            settings:layout="@layout/adaptive_preference_card_bottom">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.devrinth.launchpad"
                android:targetClass="com.devrinth.launchpad.activities.SettingsActivity" />
        </Preference>

</PreferenceScreen>
