<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/my_personal_title">

   <com.android.settingslib.widget.IllustrationPreference
        android:key="qs_header_illustration"
        android:order="-1001"
        settings:searchable="false"
        app:lottie_rawRes="@raw/display" />

    <!-- Daily Journal -->
    <Preference
        android:key="daily_journal_pref"
        android:title="@string/daily_journal_title"
        android:summary="@string/daily_journal_summary"
        android:order="3"
        settings:controller="com.epic.fragments.DailyJournalController">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.demizo.daily_you"
            android:targetClass="com.demizo.daily_you.MainActivity" />
    </Preference>

    
</PreferenceScreen>
