<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/device_tweaks_title">

    <PreferenceCategory
        android:title="@string/power_tweaks_category_charging">

        <SwitchPreference
            android:key="fast_charging"
            android:title="@string/fast_charging_title"
            android:summary="@string/fast_charging_summary"
            android:defaultValue="false"
            settings:controller="com.epic.fragments.FastChargingController" />

        <SwitchPreference
            android:key="stay_awake_charging"
            android:title="@string/stay_awake_charging_title"
            android:summary="@string/stay_awake_charging_summary"
            android:defaultValue="false"
            settings:controller="com.epic.fragments.StayAwakeChargingController" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Developer &amp; USB Security"
        android:key="developer_usb_category">

        <SwitchPreference
            android:key="usb_debugging"
            android:title="@string/usb_debugging_title"
            android:summary="@string/usb_debugging_summary"
            android:defaultValue="false"
            settings:controller="com.epic.fragments.UsbDebuggingController" />

        <SwitchPreference
            android:key="developer_options"
            android:title="@string/developer_options_title"
            android:summary="@string/developer_options_summary"
            android:defaultValue="false"
            settings:controller="com.epic.fragments.DeveloperOptionsController" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="recent_apps_category"
        android:title="@string/recent_app_category_title"
        android:order="-998"
        settings:searchable="false">
        <!-- Placeholder for a list of recent apps -->

        <!-- See all apps -->
        <Preference
            android:key="see_all_apps"
            android:title="@string/default_see_all_apps_title"
            android:fragment="com.android.settings.applications.manageapplications.ManageApplications"
            android:order="5"
            settings:searchable="false"
            settings:layout="@layout/adaptive_preference_card" />
    </PreferenceCategory>

</PreferenceScreen>
