    <PreferenceCategory
        android:title="Developer &amp; USB Security"
        android:key="developer_usb_category">

        <SwitchPreference
            android:key="usb_debugging"
            android:title="@string/usb_debugging_title"
            android:summary="@string/usb_debugging_summary"
            android:defaultValue="false"
            settings:controller="com.bmobile.fragments.UsbDebuggingController" />

        <SwitchPreference
            android:key="developer_options"
            android:title="@string/developer_options_title"
            android:summary="@string/developer_options_summary"
            android:defaultValue="false"
            settings:controller="com.bmobile.fragments.DeveloperOptionsController" />

    </PreferenceCategory>


    <Preference
        android:key="security_advanced_settings"
        android:title="@string/security_advanced_settings"
        android:summary="@string/summary_placeholder"
        android:order="40"
        settings:layout="@layout/adaptive_preference_card_top"
        android:fragment="com.android.settings.security.SecurityAdvancedSettings" />

    <Preference
        android:key="nav_settings_backup_restore"
        android:title="@string/settings_backup_restore_title"
        android:summary="@string/settings_backup_restore_intro_summary"
        android:order="50"
        settings:layout="@layout/adaptive_preference_card_middle"
        android:fragment="com.bmobile.fragments.SettingsBackupRestore" />

    <Preference
        android:key="auto_reboot_settings"
        android:title="@string/auto_reboot_title"
        android:summary="@string/auto_reboot_summary"
        android:fragment="com.bmobile.fragments.AutoRebootSettings"
        android:order="100"
        settings:layout="@layout/adaptive_preference_card_bottom" />

</PreferenceScreen>
