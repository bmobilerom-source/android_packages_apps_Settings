<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/extended_security_title">

    <!-- Illustration -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="extended_security_illustration"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/security" />

    <!-- Header -->
    <PreferenceCategory
        android:title="@string/extended_security_title"
        android:order="-1000"
        android:layout="@layout/settings_title_header_small">
    </PreferenceCategory>

    <!-- TopIntro -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="extended_security_top_intro"
        android:title="@string/extended_security_intro"
        android:persistent="false"
        android:order="-999"/>

    <!-- Authentication Category -->
    <PreferenceCategory
        android:title="@string/extended_security_authentication_category"
        android:order="0"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Fingerprint Ripple Effect -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="auth_ripple_enabled"
            android:title="@string/enable_fingerprint_ripple_effect_title"
            android:summary="@string/enable_fingerprint_ripple_effect_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <!-- Privacy & Interface Category -->
    <PreferenceCategory
        android:title="@string/extended_security_privacy_category"
        android:order="1"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Show Clipboard Overlay -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="show_clipboard_overlay"
            android:title="@string/show_clipboard_overlay_title"
            android:summary="@string/show_clipboard_overlay_summary"
            android:defaultValue="true" />

        <!-- No Storage Restrict -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="no_storage_restrict"
            android:title="@string/no_storage_restrict_title"
            android:summary="@string/no_storage_restrict_summary"
            android:defaultValue="false" />

        <!-- Ignore Window Secure Flags -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="window_ignore_secure"
            android:title="@string/ignore_window_secure_title"
            android:summary="@string/ignore_window_secure_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Lock Screen Category -->
    <PreferenceCategory
        android:title="@string/extended_security_lockscreen_category"
        android:order="2"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Hide on Secure Lock Screen -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="secure_lockscreen_qs_disabled"
            android:title="@string/quick_settings_secure_lock_screen_title"
            android:summary="@string/quick_settings_secure_lock_screen_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Developer Options Category -->
    <PreferenceCategory
        android:title="@string/extended_security_developer_category"
        android:order="3"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Hide Developer Status -->
        <Preference
            android:key="hide_developer_status_settings"
            android:title="@string/hide_developer_status_title"
            android:summary="@string/hide_developer_status_summary"
            android:fragment="com.epic.fragments.HideDeveloperStatusSettings" />

    </PreferenceCategory>

</PreferenceScreen>

