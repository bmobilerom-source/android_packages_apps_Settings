<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/extended_security_title">

    <!-- Illustration -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="extended_security_illustration"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/security" />

    <!-- Header -->
    <PreferenceCategory
        android:title="@string/extended_security_title"
        android:order="-1000"
        android:layout="@layout/settings_title_header_small">
    </PreferenceCategory>

    <!-- TopIntro -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="extended_security_top_intro"
        android:title="@string/extended_security_intro"
        android:persistent="false"
        android:order="-999"/>

    <!-- Sensor Block Per Package - Moved to top -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="sensor_block_settings"
        android:title="@string/sensor_block_title"
        android:summary="@string/sensor_block_summary"
        android:fragment="com.epic.fragments.SensorBlockSettings"
        android:order="-998"
        app:position="top" />

    <!-- Password Protection for Settings Pages - Moved to top -->
    <com.android.settings.preferences.ui.AdaptiveSwitchPreference
        android:key="settings_password_protection_enabled"
        android:title="@string/settings_password_protection_title"
        android:summary="@string/settings_password_protection_summary"
        android:defaultValue="false"
        android:order="-997"
        app:position="bottom" />

    <!-- Authentication Category -->
    <PreferenceCategory
        android:title="@string/extended_security_authentication_category"
        android:order="0"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Protected Fragments Selection -->
        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="settings_password_protected_fragments"
            android:title="@string/settings_password_protected_fragments_title"
            android:summary="@string/settings_password_protected_fragments_summary"
            android:fragment="com.epic.fragments.PasswordProtectedFragmentsSettings"
            app:position="middle"
            android:visible="false" />

        <!-- Fingerprint Ripple Effect -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="auth_ripple_enabled"
            android:title="@string/enable_fingerprint_ripple_effect_title"
            android:summary="@string/enable_fingerprint_ripple_effect_summary"
            android:defaultValue="true"
            app:position="bottom" />

    </PreferenceCategory>

    <!-- Fingerprint Category -->
    <PreferenceCategory
        android:key="extended_security_fingerprint_category"
        android:title="@string/extended_security_fingerprint_category"
        android:order="0"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Authentication Success Vibration -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="fp_success_vibrate"
            android:title="@string/fingerprint_success_vibration_title"
            android:summary="@string/fingerprint_success_vibration_summary"
            android:defaultValue="true"
            app:position="top" />

        <!-- Authentication Error Vibration -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="fp_error_vibrate"
            android:title="@string/fingerprint_error_vibration_title"
            android:summary="@string/fingerprint_error_vibration_summary"
            android:defaultValue="true"
            app:position="bottom" />

    </PreferenceCategory>

    <!-- Privacy & Interface Category -->
    <PreferenceCategory
        android:title="@string/extended_security_privacy_category"
        android:order="1"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Show Clipboard Overlay -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="show_clipboard_overlay"
            android:title="@string/show_clipboard_overlay_title"
            android:summary="@string/show_clipboard_overlay_summary"
            android:defaultValue="true"
            app:position="top" />

        <!-- No Storage Restrict -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="no_storage_restrict"
            android:title="@string/no_storage_restrict_title"
            android:summary="@string/no_storage_restrict_summary"
            android:defaultValue="false"
            app:position="middle" />

        <!-- Ignore Window Secure Flags -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="window_ignore_secure"
            android:title="@string/ignore_window_secure_title"
            android:summary="@string/ignore_window_secure_summary"
            android:defaultValue="false"
            app:position="bottom" />

    </PreferenceCategory>

    <!-- Lock Screen Category -->
    <PreferenceCategory
        android:title="@string/extended_security_lockscreen_category"
        android:order="2"
        android:layout="@layout/settingslib_preference_category_no_title">

        <!-- Hide on Secure Lock Screen -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
            android:key="secure_lockscreen_qs_disabled"
            android:title="@string/quick_settings_secure_lock_screen_title"
            android:summary="@string/quick_settings_secure_lock_screen_summary"
            android:defaultValue="false"
            app:position="solo" />

    </PreferenceCategory>

    <!-- Battery Saving Category -->
    <PreferenceCategory
        android:title="@string/extended_security_battery_saving_category"
        android:order="3"
        android:layout="@layout/settingslib_preference_category_no_title">
    </PreferenceCategory>


</PreferenceScreen>

