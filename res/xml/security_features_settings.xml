<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/security_features_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="security_features_illustration"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/security" />

    <com.android.settingslib.widget.TopIntroPreference
        android:key="security_features_intro"
        android:order="-1000"
        android:title="@string/security_features_intro_title"
        android:summary="@string/security_features_intro_summary"
        android:persistent="false" />

    <PreferenceCategory
        android:title="@string/security_features_category_data"
        android:key="security_data_category"
        android:order="10">

        <SwitchPreference
            android:key="block_analytics_toggle"
            android:title="@string/block_analytics_title"
            android:summary="@string/block_analytics_summary"
            android:order="11"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockAnalyticsController" />

        <SwitchPreference
            android:key="block_diagnostic_data_toggle"
            android:title="@string/block_diagnostic_data_title"
            android:summary="@string/block_diagnostic_data_summary"
            android:order="12"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockDiagnosticDataController" />

        <SwitchPreference
            android:key="block_personalization_toggle"
            android:title="@string/block_personalization_title"
            android:summary="@string/block_personalization_summary"
            android:order="13"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockPersonalizationController" />

        <SwitchPreference
            android:key="block_android_intelligence_toggle"
            android:title="@string/block_android_intelligence_title"
            android:summary="@string/block_android_intelligence_summary"
            android:order="14"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockAndroidIntelligenceController" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/security_features_category_services"
        android:key="security_services_category"
        android:order="20">

        <SwitchPreference
            android:key="block_ad_services_toggle"
            android:title="@string/block_ad_services_title"
            android:summary="@string/block_ad_services_summary"
            android:order="21"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockAdServicesController" />

        <SwitchPreference
            android:key="block_cloud_backup_toggle"
            android:title="@string/block_cloud_backup_title"
            android:summary="@string/block_cloud_backup_summary"
            android:order="22"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockCloudBackupController" />

        <SwitchPreference
            android:key="block_location_services_toggle"
            android:title="@string/block_location_services_title"
            android:summary="@string/block_location_services_summary"
            android:order="23"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockLocationServicesController" />

        <SwitchPreference
            android:key="block_network_scanning_toggle"
            android:title="@string/block_network_scanning_title"
            android:summary="@string/block_network_scanning_summary"
            android:order="24"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockNetworkScanningController" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/security_features_category_updates"
        android:key="security_updates_category"
        android:order="30">

        <SwitchPreference
            android:key="block_webview_updates_toggle"
            android:title="@string/block_webview_updates_title"
            android:summary="@string/block_webview_updates_summary"
            android:order="31"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockWebViewUpdatesController" />

        <SwitchPreference
            android:key="block_system_updates_toggle"
            android:title="@string/block_system_updates_title"
            android:summary="@string/block_system_updates_summary"
            android:order="32"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockSystemUpdatesController" />

        <SwitchPreference
            android:key="block_app_installation_toggle"
            android:title="@string/block_app_installation_title"
            android:summary="@string/block_app_installation_summary"
            android:order="33"
            android:persistent="false"
            settings:controller="com.android.settings.applications.specialaccess.BlockAppInstallationController" />

    </PreferenceCategory>

</PreferenceScreen>


