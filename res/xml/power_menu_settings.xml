<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="power_menu_settings_screen"
    android:title="Power Menu &amp; Theming">

    <!-- Navigation to separate pages -->
    <Preference
        android:key="enhanced_power_menu"
        android:title="Enhanced Power Menu"
        android:summary="Custom power menu options and buttons"
        android:fragment="com.android.settings.display.EnhancedPowerMenuSettings" />

    <Preference
        android:key="wallet_settings"
        android:title="Quick Access Wallet"
        android:summary="Wallet integration and loyalty cards"
        android:fragment="com.android.settings.display.WalletSettings" />

    <Preference
        android:key="device_controls_settings"
        android:title="Device Controls"
        android:summary="Smart home controls in power menu"
        android:fragment="com.android.settings.display.DeviceControlsSettings" />

    <Preference
        android:key="advanced_monet_settings"
        android:title="Advanced Material You"
        android:summary="Advanced theming and color customization"
        android:fragment="com.android.settings.display.AdvancedMonetSettings" />

</PreferenceScreen>