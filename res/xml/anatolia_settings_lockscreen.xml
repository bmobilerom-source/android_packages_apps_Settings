<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
	android:title=" ">

    <!-- Monet Color Presets -->
    <Preference
        android:key="monet_color_presets"
        android:title="Material You Color Presets"
        android:summary="Choose from predefined color themes"
        settings:layout="@layout/adaptive_preference_card">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.android.settings"
            android:targetClass="com.android.settings.display.MonetPresetGalleryActivity" />
    </Preference>

    <!-- Contextual Colors -->
    <Preference
        android:key="contextual_colors_settings"
        android:title="Contextual Colors"
        android:summary="Dynamic colors based on app content"
        android:fragment="com.android.settings.display.ContextualColorsSettings"
        settings:layout="@layout/adaptive_preference_card" />

</PreferenceScreen>
