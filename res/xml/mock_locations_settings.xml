<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/mock_location_app">

    <!-- Lottie Animation - Always at top -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="mock_location_illustration"
        android:order="-1001"
        settings:searchable="false"
        app:lottie_rawRes="@raw/location" />

    <!-- Header -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="mock_location_intro"
        android:order="-1000"
        android:title="@string/mock_location_intro_title"
        android:summary="@string/mock_location_intro_summary" />

    <!-- Mock Location App Preference -->
    <Preference
        android:key="mock_location_app"
        android:title="@string/mock_location_app"
        android:summary="@string/mock_location_app_not_set"
        settings:controller="com.android.settings.location.MockLocationAppPreferenceController"
        settings:layout="@layout/adaptive_preference_card" />


</PreferenceScreen>

