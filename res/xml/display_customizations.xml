<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/display_customizations_title">

    <!-- Lottie Animation -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="display_customizations_illustration"
        android:order="-1001"
        settings:searchable="false"
        app:lottie_rawRes="@raw/display"/>

    <!-- Header -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="display_customizations_intro"
        android:title="@string/display_customizations_intro_title"
        android:summary="@string/display_customizations_intro_summary"
        android:order="-1000" />

    <!-- Navigation to Display Customizations 2 -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="display_customization_2"
        android:title="@string/display_customizations2_title"
        android:summary="@string/display_customizations2_summary"
        android:fragment="com.android.settings.awaken.fragments.DisplayCustomizations2"
        app:position="top" />
        
    <!-- Navigation to Display Customizations 3 -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="display_customization_3"
        android:title="@string/display_customizations3_title"
        android:summary="@string/display_customizations3_summary"
        android:fragment="com.android.settings.awaken.fragments.DisplayCustomizations3"
        app:position="middle" />
        
    <!-- Navigation to Display Customizations 4 -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="display_customization_4"
        android:title="@string/display_customizations4_title"
        android:summary="@string/display_customizations4_summary"
        android:fragment="com.android.settings.awaken.fragments.DisplayCustomizations4"
        app:position="middle" />

    <!-- Navigation to Display Customizations 5 -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="display_customization_5"
        android:title="@string/display_customizations5_title"
        android:summary="@string/display_customizations5_summary"
        android:fragment="com.android.settings.awaken.fragments.DisplayCustomizations5"
        app:position="bottom" />

</PreferenceScreen>
