<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/display_page_colors_title">

    <!-- Lottie Animation -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="display_page_colors_illustration"
        android:order="-1001"
        settings:searchable="false"
        app:lottie_rawRes="@raw/color_motion" />

    <!-- Header -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="display_page_colors_intro"
        android:title="@string/display_page_colors_title"
        android:summary="@string/display_page_colors_summary"
        android:order="-1000" />

    <!-- Color Contrast -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="color_contrast"
        android:title="@string/accessibility_color_contrast_title"
        android:summary="@string/accessibility_color_contrast_summary"
        android:fragment="com.android.settings.display.ColorContrastFragment"
        android:order="1"
        app:position="top" />

    <!-- Colors (Color mode) -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="color_mode"
        android:title="@string/color_mode_title"
        android:summary="@string/color_mode_option_automatic"
        android:fragment="com.android.settings.display.ColorModePreferenceFragment"
        android:order="2"
        app:position="middle" />

    <!-- Live Display -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="live_display"
        android:title="@string/live_display_title"
        android:summary="@string/live_display_summary"
        android:order="3"
        app:position="middle" />

    <!-- Color and Motion -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="color_and_motion"
        android:title="@string/accessibility_color_and_motion_title"
        android:summary="@string/accessibility_color_and_motion_summary"
        android:fragment="com.android.settings.accessibility.ColorAndMotionFragment"
        android:order="4"
        app:position="middle" />

    <!-- Screen Saver -->
    <com.android.settings.preferences.ui.AdaptivePreference
        android:key="screen_saver"
        android:title="@string/screensaver_settings_title"
        android:summary="@string/screensaver_settings_when_to_dream"
        android:fragment="com.android.settings.dream.DreamSettings"
        android:order="5"
        app:position="bottom" />

</PreferenceScreen>

