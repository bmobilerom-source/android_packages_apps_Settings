<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/adaptive_playback_screen_title">

    <!-- Lottie Animation -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="adaptive_playback_illustration"
        android:layout="@layout/adaptive_playback_illustration"
        settings:searchable="false" />

    <!-- Master Switch -->
    <SwitchPreferenceCompat
        android:key="adaptive_playback_enabled"
        android:title="@string/adaptive_playback_enabled"
        android:summary="@string/adaptive_playback_intro_text"
        android:defaultValue="false"
        android:persistent="false" />

    <!-- Timeout Options Category -->
    <PreferenceCategory
        android:key="adaptive_playback_category"
        android:title="@string/adaptive_playback_timeout_title"
        android:layout="@layout/preference_category_no_label">

        <!-- Radio buttons will be added programmatically -->
    </PreferenceCategory>

</PreferenceScreen>
