<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="top_level_settings"
    android:title="Settings">

    <!-- Compact Style - Grid layout with cards, header removed per user request -->
  
    <com.android.settingslib.widget.LayoutPreference
        android:key="compact_dashboard_grid"
        android:selectable="false"
        android:layout="@layout/compact_dashboard_two_column_grid" />

    <com.android.settings.widget.HomepagePreference
        android:fragment="com.epic.fragments.CustomDashboardSettings"
        android:icon="@drawable/ic_custom_dashboard"
        android:key="top_level_custom_dashboard"
        android:order="-100"
        android:title="@string/custom_dashboard_title"
        android:summary="@string/custom_dashboard_summary"
        settings:highlightableMenuKey="@string/menu_key_system" />

</PreferenceScreen>


