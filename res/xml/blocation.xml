<PreferenceScreen
     xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="blocation_settings"
    android:title="@string/location_privacy_dashboard_title"
    settings:keywords="@string/keywords_location">
    <com.android.settingslib.widget.IllustrationPreference
        android:key="apps_illustration_video"
        settings:searchable="false"
        android:order="-1000"
        settings:lottie_rawRes="@raw/location"/>
    <!-- Location Privacy Dashboard -->
    <PreferenceCategory
        android:key="location_privacy_category"
        android:title="@string/location_privacy_dashboard_title"
        android:summary="@string/location_privacy_dashboard_summary"
        android:order="5"
        settings:layout="@layout/adaptive_preference_card_top">

        <!-- Privacy Indicators -->
        <Preference
            android:key="location_privacy_indicators"
            android:title="@string/location_apps_with_access"
            android:summary="@string/location_recent_access_count"
            android:order="6"
            settings:controller="com.android.settings.location.LocationPrivacyIndicatorsController"
            settings:layout="@layout/adaptive_preference_card"/>

        <!-- Granular Permission Controls -->
        <ListPreference
            android:key="location_precision"
            android:title="@string/location_precision_title"
            android:summary="@string/location_precision_summary"
            android:entries="@array/location_precision_entries"
            android:entryValues="@array/location_precision_values"
            android:defaultValue="precise"
            android:order="7"
            android:selectable="true"
            settings:layout="@layout/adaptive_preference_card"
            settings:controller="com.android.settings.location.LocationPrecisionController"/>

        <Preference
            android:key="location_time_restrictions"
            android:title="@string/location_time_restrictions_title"
            android:summary="@string/location_time_restrictions_summary"
            android:order="8"
            settings:layout="@layout/adaptive_preference_card_top"
            android:fragment="com.android.settings.location.LocationTimeRestrictionsFragment"/>

        <Preference
            android:key="location_app_overrides"
            android:title="@string/location_app_overrides_title"
            settings:layout="@layout/adaptive_preference_card_middle"
            android:summary="@string/location_app_overrides_summary"
            android:order="9"
            android:fragment="com.android.settings.location.LocationAppOverridesFragment"
            settings:isPreferenceVisible="false"/>

        <Preference
            android:key="location_sharing_controls"
            settings:layout="@layout/adaptive_preference_card_bottom"
            android:title="@string/location_sharing_controls_title"
            android:summary="@string/location_sharing_controls_summary"
            android:order="10"
            android:fragment="com.android.settings.location.LocationSharingControlsFragment"/>

        <!-- Mock Location Toggle -->
        <SwitchPreference
            android:key="mock_location_toggle"
            android:title="@string/mock_location_title"
            android:summary="@string/mock_location_disabled_summary"
            android:order="11"
            android:defaultValue="false"
            settings:controller="com.android.settings.location.MockLocationController"
            settings:isPreferenceVisible="false"/>

        <!-- Mock Location Warning -->
        <Preference
            android:key="mock_location_warning"
            android:title="@string/mock_location_warning_title"
            android:summary="@string/mock_location_warning_summary"
            android:order="12"
            settings:layout="@layout/adaptive_preference_card"
            android:selectable="true"
            settings:controller="com.android.settings.location.MockLocationWarningController"
            settings:isPreferenceVisible="false"/>
    </PreferenceCategory>

    <!-- Location Status Indicators -->
    <PreferenceCategory
        android:key="location_status_category"
        android:title="@string/location_status_title"
        android:order="13"
        settings:layout="@layout/adaptive_preference_card">

        <!-- Service Status -->
        <Preference
            android:key="location_service_status"
            android:title="@string/location_status_gps_active"
            android:summary="@string/location_accuracy_high"
            android:order="12"
            settings:controller="com.android.settings.location.LocationServiceStatusController"
            settings:layout="@layout/adaptive_preference_card_top"/>

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:title="These enhanced location privacy features help you maintain better control over your location data and understand location service status."
        android:key="blocation_footer"
        settings:searchable="false"
        settings:controller="com.android.settings.location.LocationPrivacyFooterController"/>
</PreferenceScreen>

