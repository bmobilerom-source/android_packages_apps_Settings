<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="display_color_settings_screen"
    android:title="@string/display_color_settings_title">

    <!-- Header -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="display_color_intro"
        android:title="@string/display_color_settings_title"
        android:summary="@string/display_color_settings_summary"
        android:order="-1000" />

    <!-- Color Customization Category -->
    <PreferenceCategory
        android:title="@string/display_color_category_title"
        android:key="color_customization_category"
        android:order="1">

        <!-- Monet Color Settings -->
        <Preference
            android:key="monet_color_settings"
            android:title="@string/display_page_grid_monet_color_title"
            android:summary="@string/display_page_grid_monet_color_summary"
            android:fragment="com.android.settings.display.MonetColorSettings"
            settings:layout="@layout/adaptive_preference_card" />

        <!-- Color Mode -->
        <Preference
            android:key="color_mode"
            android:title="@string/color_mode_title"
            android:summary="@string/color_mode_option_automatic"
            android:fragment="com.android.settings.display.ColorModePreferenceFragment"
            settings:layout="@layout/adaptive_preference_card" />

        <!-- Color Contrast -->
        <Preference
            android:key="color_contrast"
            android:title="@string/accessibility_color_contrast_title"
            android:summary="@string/accessibility_color_contrast_summary"
            android:fragment="com.android.settings.display.ColorContrastFragment"
            settings:layout="@layout/adaptive_preference_card" />

        <!-- Color Temperature Toggle -->
        <SwitchPreference
            android:key="color_temperature"
            android:title="@string/color_temperature"
            android:summary="@string/color_temperature_desc"
            android:defaultValue="false"
            settings:controller="com.android.settings.display.ColorTemperatureController" />

    </PreferenceCategory>

</PreferenceScreen>


