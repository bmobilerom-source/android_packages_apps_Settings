<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="device_controls_settings_screen"
    android:title="Device Controls">

    <!-- Device Controls -->
    <PreferenceCategory
        android:title="Device Controls"
        android:key="device_controls_category">

        <SwitchPreference
            android:key="controls_in_power_menu"
            android:title="Controls in Power Menu"
            android:summary="Show device controls in power menu when locked/unlocked"
            android:defaultValue="false"
            settings:controller="com.android.settings.display.DeviceControlsController" />

        <SwitchPreference
            android:key="controls_unlocked_only"
            android:title="Controls Require Unlock"
            android:summary="Require authentication to interact with controls"
            android:defaultValue="true"
            settings:controller="com.android.settings.display.ControlsUnlockController" />

    </PreferenceCategory>

</PreferenceScreen>
