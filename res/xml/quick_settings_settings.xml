<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="quick_settings_settings_screen"
    android:title="@string/quick_settings_settings_title">

    <PreferenceCategory
        android:title="@string/quick_settings_tiles_category"
        android:key="quick_settings_tiles_category">

        <!-- Note: Volume unmute percentage requires SystemUI modification to work -->
        <lineageos.preference.LineageSystemSettingSeekBarPreference
            android:key="qs_volume_unmute_percentage"
            android:title="@string/qs_volume_unmute_title"
            android:summary="@string/qs_volume_unmute_summary"
            android:defaultValue="50"
            android:max="100"
            android:min="0"
            settings:interval="5" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="leveled_flashlight_tile"
            android:title="@string/qs_leveled_flashlight_title"
            android:summary="@string/qs_leveled_flashlight_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="flashlight_level_global"
            android:title="@string/qs_flashlight_level_global_title"
            android:summary="@string/qs_flashlight_level_global_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingSeekBarPreference
            android:key="qs_tile_label_scale"
            android:title="@string/qs_tile_label_size"
            android:summary="@string/qs_tile_label_size_summary"
            android:defaultValue="0"
            android:max="50"
            android:min="-50"
            settings:interval="5" />

        <lineageos.preference.LineageSystemSettingSeekBarPreference
            android:key="qs_secondary_label_scale"
            android:title="@string/qs_tile_secondary_label_size"
            android:summary="@string/qs_tile_secondary_label_size_summary"
            android:defaultValue="0"
            android:max="50"
            android:min="-50"
            settings:interval="5" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/qs_pulldown_category"
        android:key="qs_pulldown_category">

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="qs_pulldown_enabled"
            android:title="@string/qs_pulldown_switch_title"
            android:summary="@string/qs_pulldown_switch_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingSeekBarPreference
            android:key="qs_pulldown_percentage"
            android:title="@string/qs_pulldown_size"
            android:summary="@string/qs_pulldown_size_summary"
            android:defaultValue="25"
            android:max="50"
            android:min="10"
            settings:interval="5" />

        <ListPreference
            android:defaultValue="1"
            android:entries="@array/qs_pulldown_side_entries"
            android:entryValues="@array/qs_pulldown_side_values"
            android:key="qs_pulldown_side"
            android:summary="%s"
            android:title="@string/qs_pulldown_side_title" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="one_finger_pullup_enabled"
            android:title="@string/qs_pullup_switch_title"
            android:summary="@string/qs_pullup_switch_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
