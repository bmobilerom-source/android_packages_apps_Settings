<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/custom_theme_title">

    <!-- Lottie Illustration - Always at top -->
    <com.android.settingslib.widget.IllustrationPreference
        android:key="custom_theme_illustration"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/color_motion"
        android:visible="false" />

    <!-- Top Intro - Hidden -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="custom_theme_intro"
        android:order="-999"
        android:title="@string/custom_theme_intro_title"
        android:summary="@string/custom_theme_intro_summary"
        android:persistent="false"
        android:visible="false" />

    <!-- Custom Themes Category - All themes work only in dark mode -->
    <PreferenceCategory
        android:key="custom_theme_category"
        android:title="@string/custom_theme_category_title"
        android:order="0"
        android:summary="@string/custom_theme_category_summary" />

    <ListPreference
        android:key="custom_theme"
        android:title="@string/custom_theme_title"
        android:summary="%s"
        android:entries="@array/custom_theme_entries"
        android:entryValues="@array/custom_theme_values"
        android:defaultValue="0"
        android:persistent="false"
        android:order="1" />

    <!-- Theme Descriptions - Hidden for now -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="theme_default_desc"
        android:order="11"
        android:title="@string/custom_theme_default"
        android:summary="@string/custom_theme_default_desc"
        android:persistent="false"
        android:visible="false" />

    <com.android.settingslib.widget.TopIntroPreference
        android:key="theme_espresso_desc"
        android:order="15"
        android:title="@string/custom_theme_espresso"
        android:summary="@string/custom_theme_espresso_desc"
        android:persistent="false"
        android:visible="false" />

    <com.android.settingslib.widget.TopIntroPreference
        android:key="theme_custom_blue_desc"
        android:order="16"
        android:title="@string/custom_theme_custom_blue"
        android:summary="@string/custom_theme_custom_blue_desc"
        android:persistent="false"
        android:visible="false" />

    <com.android.settingslib.widget.TopIntroPreference
        android:key="theme_animated_wallpaper_blur_desc"
        android:order="19"
        android:title="@string/custom_theme_animated_wallpaper_blur"
        android:summary="@string/custom_theme_animated_wallpaper_blur_desc"
        android:persistent="false"
        android:visible="false" />

    <!-- Wallpaper Background Preference -->
    <PreferenceCategory
        android:key="wallpaper_background_category"
        android:title="@string/wallpaper_background_category_title"
        android:order="20" />

    <Preference
        android:key="wallpaper_background_preference"
        android:title="@string/settings_wallpaper_background_title"
        android:summary="@string/settings_wallpaper_background_summary"
        android:order="21"
        settings:layout="@layout/system_warning_preference_card" />

</PreferenceScreen>
