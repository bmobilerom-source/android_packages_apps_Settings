<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings">


    <com.android.settingslib.widget.IllustrationPreference
        android:key="aboutus_illustration"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/aboutus"/>

    <!-- Accessibility Header -->
    <PreferenceCategory
        android:title="About Us"
        android:order="-998"
        android:layout="@layout/settings_title_header" />
   
    <!-- intro -->
    <com.android.settingslib.widget.TopIntroPreference
        android:key="aboutus_bubbles_desc"
        android:order="-997"
        android:title="@string/aboutus_bubble_setting_description" />
      
    <!-- system info -->
    <Preference
        android:key="system_info"
        android:title="@string/about_us_info_system_title"
        android:summary="@string/about_us_info_system_title_summary"
        android:order="-990"
        settings:layout="@layout/system_features_preference_card">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="dev.sebaubuntu.athena"
                android:targetClass="dev.sebaubuntu.athena.MainActivity" />
    </Preference>

    <!-- website -->
    <Preference
        android:key="about_us_info"
        android:title="@string/about_us_info"
        settings:layout="@layout/system_help_preference_card"
        android:summary="@string/about_us_info_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://github.com/bashamobile" />
    </Preference>

    <!-- telegram help -->
    <Preference
        android:key="aboutus_link"
        android:title="@string/aboutus_link_title"
        settings:layout="@layout/system_help_preference_card"
        android:summary="@string/aboutus_link_summary">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="https://t.me/orchidosdemo" />
    </Preference>

</PreferenceScreen>
