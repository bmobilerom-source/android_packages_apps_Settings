<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
     xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title=" ">


    <com.android.settingslib.widget.IllustrationPreference
        android:key="privacy"
        settings:searchable="false"
        android:order="-1001"
        app:lottie_rawRes="@raw/privacy"/> 

   <!-- Header -->
  <PreferenceCategory
        android:title="Reset options"
        android:order="-1000"
        android:layout="@layout/settings_title_header_small">
  </PreferenceCategory>

    <!-- TopIntro -->
    <!-- TopIntro - Commented out (empty preference hidden)
    <com.android.settingslib.widget.TopIntroPreference
        android:key="reset_options_top_intro"
        android:title="Reset options"
        android:persistent="false"
        android:order="-999"/>
    -->

    <!-- Footer -->
    <!-- Note: No Footer present in this page -->

    <!-- Other Preferences -->
    <PreferenceCategory
        android:key="reset_options_category"
        android:layout="@layout/settingslib_preference_category_no_title"
        android:order="0">
        
        <!-- Mobile Network reset -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedPreference
            android:key="network_reset_mobile_network_settings_pref"
            android:title="@string/reset_mobile_network_settings_title"
            android:order="0"
            app:position="top"
            settings:userRestriction="no_network_reset"
            settings:useAdminDisabledSummary="true"
            settings:isPreferenceVisible="@bool/config_show_sim_info"
            android:fragment="com.android.settings.ResetNetwork" />

        <!-- Reset app preferences -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedPreference
            android:key="reset_app_prefs"
            android:title="@string/reset_app_preferences"
            android:order="1"
            app:position="middle"
            settings:userRestriction="no_control_apps" />

        <!-- Factory reset -->
        <com.android.settings.preferences.ui.AdaptiveRestrictedPreference
            android:key="factory_reset"
            android:title="@string/main_clear_title"
            android:order="2"
            app:position="middle"
            settings:keywords="@string/keywords_factory_data_reset"
            settings:userRestriction="no_factory_reset"
            settings:useAdminDisabledSummary="true"
            settings:controller="com.android.settings.system.FactoryResetPreferenceController"
            android:fragment="com.android.settings.MainClear" />

        <!-- Bluetooth and WiFi reset -->
        <!-- Note: ComposePreference is kept as-is due to Compose UI requirements -->
        <com.android.settings.spa.preference.ComposePreference
            android:key="network_reset_bluetooth_wifi_pref"
            android:title="@string/reset_bluetooth_wifi_title"
            android:persistent="false"
            android:order="3"
            android:layout="@layout/preference_compose_top_intro"
            settings:searchable="false"
            settings:controller="com.android.settings.network.BluetoothWiFiResetPreferenceController" />

        <!-- Erase Euicc data -->
        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="erase_euicc_data"
            android:title="@string/reset_esim_title"
            android:order="4"
            app:position="middle"
            settings:isPreferenceVisible="@bool/config_show_sim_info"
            settings:controller="com.android.settings.network.EraseEuiccDataController" />

        <!-- Delete private space -->
        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="reset_delete_private_space"
            android:title="@string/reset_private_space_delete_title"
            android:order="5"
            app:position="middle"
            settings:controller="com.android.settings.privatespace.delete.ResetOptionsDeletePrivateSpaceController" />

        <!-- Factory reset demo user -->
        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="factory_reset_demo_user"
            android:title="@string/main_clear_title"
            android:order="6"
            app:position="middle"
            settings:keywords="@string/keywords_factory_data_reset"
            settings:controller="com.android.settings.system.FactoryResetDemoUserPreferenceController"
            android:fragment="com.android.settings.MainClear" />

        <!-- Remove items -->
        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="remove_items"
            android:title="File Deletion"
            android:summary="Delete unnecessary files and free up space"
            android:order="7"
            app:position="bottom">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.android.storagemanager"
                android:targetClass="com.android.storagemanager.deletionhelper.DeletionHelperActivity" />
        </com.android.settings.preferences.ui.AdaptivePreference>
    </PreferenceCategory>

    <!-- Switches -->
    <!-- Note: No Switches present in this page -->

    <!-- SeekBars -->
    <!-- Note: No SeekBars present in this page -->
</PreferenceScreen>
