<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="top_level_settings">

    <com.android.settingslib.widget.LayoutPreference
        android:layout="@layout/mainuser_profile_card"
        android:key="about_device_info"
        android:order="-2000"
        android:selectable="true"
        android:fragment="com.android.settings.deviceinfo.UserInfoFragement" />

    <com.android.settingslib.widget.LayoutPreference
        android:key="extended_homepage_widgets"
        android:layout="@layout/extended_homepage_widgets"
        android:order="-1995"
        android:selectable="false" />

    <com.android.settingslib.widget.LayoutPreference
        android:key="infinity_home_grid"
        android:layout="@layout/bmobile_expressive_two_column_grid"
        android:order="-1990"
        android:selectable="false" />

    <com.android.settings.widget.HomepagePreference
        android:fragment="com.epic.fragments.CustomDashboardSettings"
        android:icon="@drawable/ic_custom_dashboard"
        android:key="top_level_custom_dashboard"
        android:order="-100"
        android:title="@string/custom_dashboard_title"
        android:summary="@string/custom_dashboard_summary"
        settings:highlightableMenuKey="@string/menu_key_system" />

</PreferenceScreen>
