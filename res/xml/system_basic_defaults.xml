<PreferenceScreen
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:title="@string/system_basic_defaults_title">

    <!-- Branding Header from anatolia_settings_gestures.xml -->
    <com.android.settingslib.widget.LayoutPreference
        android:key="Branding_CustomerOS_view"
        android:selectable="true"
        android:enabled="true"
        android:shouldDisableView="false"
        android:fragment="com.epic.fragments.SystemSettingsAboutus" 
        android:layout="@layout/CustomerOS_header"
        android:order="-2000" />

    <com.android.settingslib.widget.LayoutPreference
        android:key="system_basic_defaults"
        android:selectable="false"
        android:layout="@layout/system_basic_defaults_layout" />

</PreferenceScreen>

