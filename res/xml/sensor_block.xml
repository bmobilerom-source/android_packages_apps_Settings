<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/sensor_block_title">

    <!-- Master switch -->
    <com.android.settings.preferences.ui.AdaptiveRestrictedSwitchPreference
        android:key="sensor_block"
        android:title="@string/sensor_block_title"
        android:summary="@string/sensor_block_summary"
        android:defaultValue="false" />

    <!-- App picker category -->
    <PreferenceCategory
        android:title="@string/sensor_block_app_picker_title"
        android:dependency="sensor_block"
        android:key="sensor_block_applications">

        <Preference
            android:key="add_sensor_block_packages"
            android:title="@string/add_sensor_block_package_title"
            android:summary="@string/add_sensor_block_package_summary"
            android:fragment="com.epic.fragments.SensorBlockAppPicker" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="sensor_block_footer"
        android:selectable="false"
        settings:searchable="false"
        android:dependency="sensor_block" />

</PreferenceScreen>

