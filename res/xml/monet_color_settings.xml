        <SwitchPreference
            android:key="monet_tint_background"
            android:title="Tint Background"
            android:summary="Apply additional darker tinting to colors for enhanced contrast in settings"
            android:defaultValue="false"
            settings:controller="com.android.settings.display.MonetTintBackgroundController" />

    </PreferenceCategory>
    -->

</PreferenceScreen>
