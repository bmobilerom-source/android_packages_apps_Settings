<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="monet_color_settings_screen"
    android:title="@string/monet_color_settings_title">

    <!-- Current Wallpaper Colors Section -->
    <PreferenceCategory
        android:title="@string/monet_current_colors_title"
        android:key="current_colors_category">

        <!-- Wallpaper Preview -->
        <View
            android:id="@+id/wallpaper_preview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/monet_wallpaper_preview_height"
            android:layout_margin="@dimen/monet_grid_container_padding"
            android:background="@android:color/transparent" />

        <!-- Color Swatches Container -->
        <LinearLayout
            android:id="@+id/color_swatches_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_margin="@dimen/monet_grid_container_padding" />

        <!-- Current Style Indicator -->
        <Preference
            android:key="current_style_indicator"
            android:title="@string/monet_current_style_title"
            android:summary="@string/monet_current_style_summary"
            android:selectable="false" />

    </PreferenceCategory>

    <!-- Color Style Selection -->
    <PreferenceCategory
        android:title="@string/monet_style_selection_title"
        android:key="style_selection_category">

        <ListPreference
            android:key="monet_color_style"
            android:title="@string/monet_color_style_title"
            android:summary="@string/monet_color_style_summary"
            android:entries="@array/monet_color_styles"
            android:entryValues="@array/monet_color_style_values"
            android:defaultValue="tonal_spot"
            settings:controller="com.android.settings.display.MonetColorStyleController" />

    </PreferenceCategory>

    <!-- Color Presets -->
    <PreferenceCategory
        android:title="@string/monet_color_presets_title"
        android:key="color_presets_category">

        <Preference
            android:key="monet_color_presets"
            android:title="@string/monet_color_presets_title"
            android:summary="@string/monet_color_presets_summary"
            android:fragment="com.android.settings.display.MonetColorPresets"
            settings:controller="com.android.settings.display.MonetColorPresetsController" />

    </PreferenceCategory>

    <!-- Custom Gradients -->
    <PreferenceCategory
        android:title="@string/monet_custom_gradients_title"
        android:key="custom_gradients_category">

        <Preference
            android:key="monet_custom_gradients"
            android:title="@string/monet_custom_gradients_title"
            android:summary="@string/monet_custom_gradients_summary"
            android:fragment="com.android.settings.display.CustomGradientsSettings"
            settings:controller="com.android.settings.display.CustomGradientsController" />

    </PreferenceCategory>

    <!-- Time-Based Colors -->
    <PreferenceCategory
        android:title="@string/monet_time_based_colors_title"
        android:key="time_based_colors_category">

        <Preference
            android:key="monet_time_based_colors"
            android:title="@string/monet_time_based_colors_title"
            android:summary="@string/monet_time_based_colors_summary"
            android:fragment="com.android.settings.display.TimeBasedColorsSettings"
            settings:controller="com.android.settings.display.TimeBasedColorsController" />

    </PreferenceCategory>

    <!-- Contextual Colors -->
    <PreferenceCategory
        android:title="@string/monet_contextual_colors_title"
        android:key="contextual_colors_category">

        <Preference
            android:key="monet_contextual_colors"
            android:title="@string/monet_contextual_colors_title"
            android:summary="@string/monet_contextual_colors_summary"
            android:fragment="com.android.settings.display.ContextualColorsSettings"
            settings:controller="com.android.settings.display.ContextualColorsController" />

    </PreferenceCategory>

    <!-- Settings Background -->
    <PreferenceCategory
        android:title="@string/monet_settings_background_title"
        android:key="settings_background_category">

        <ListPreference
            android:key="settings_background_color_mode"
            android:title="@string/monet_settings_background_mode_title"
            android:summary="@string/monet_settings_background_mode_summary"
            android:entries="@array/settings_background_modes"
            android:entryValues="@array/settings_background_mode_values"
            android:defaultValue="wallpaper" />

        <Preference
            android:key="settings_background_custom_color"
            android:title="@string/monet_settings_background_custom_title"
            android:summary="@string/monet_settings_background_custom_summary"
            android:fragment="com.android.settings.display.SettingsBackgroundColorPicker" />

    </PreferenceCategory>

    <!-- Reset to Defaults -->
    <PreferenceCategory
        android:title="@string/monet_reset_title"
        android:key="reset_category">

        <Preference
            android:key="monet_reset_to_wallpaper"
            android:title="@string/monet_reset_to_wallpaper_title"
            android:summary="@string/monet_reset_to_wallpaper_summary" />

    </PreferenceCategory>

</PreferenceScreen>
