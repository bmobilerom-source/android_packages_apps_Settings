<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/securitygrid_card_ripple">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners
                android:topRightRadius="@dimen/securitygrid_card_radius"
                android:topLeftRadius="@dimen/securitygrid_card_radius"
                android:bottomLeftRadius="@dimen/securitygrid_card_radius"
                android:bottomRightRadius="@dimen/securitygrid_card_radius" />
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/securitygrid_card_bg" />
            <corners
                android:topRightRadius="@dimen/securitygrid_card_radius"
                android:topLeftRadius="@dimen/securitygrid_card_radius"
                android:bottomLeftRadius="@dimen/securitygrid_card_radius"
                android:bottomRightRadius="@dimen/securitygrid_card_radius" />
        </shape>
    </item>
</ripple>
