<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200"
    android:tint="?android:attr/colorOnSurface">
    
    <!-- Phone outline -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:pathData="M30,20 L170,20 A10,10 0 0,1 180,30 L180,170 A10,10 0 0,1 170,180 L30,180 A10,10 0 0,1 20,170 L20,30 A10,10 0 0,1 30,20 Z" />
    
    <!-- Screen -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M30,30 L170,30 L170,170 L30,170 Z" />
    
    <!-- Tap indicator -->
    <circle
        android:fillColor="@android:color/white"
        android:cx="100"
        android:cy="100"
        android:r="8" />
    
    <!-- Tap ripple -->
    <circle
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="2"
        android:cx="100"
        android:cy="100"
        android:r="20" />
    
</vector>
