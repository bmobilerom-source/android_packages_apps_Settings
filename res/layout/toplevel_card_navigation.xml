<?xml version="1.0" encoding="utf-8"?>
<!--
  Quick navigation row — same card background as homepage_widgets (@drawable/custom_preference_background).

  Copyright (C) 2025 BashaMobile
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/card_network"
            android:layout_width="120dp"
            android:layout_height="72dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/custom_preference_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/card_network_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/network_dashboard_title"
                android:textAlignment="center"
                android:textAppearance="?android:attr/textAppearanceListItemSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_display"
            android:layout_width="120dp"
            android:layout_height="72dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/custom_preference_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/card_display_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/display_page_grid_title"
                android:textAlignment="center"
                android:textAppearance="?android:attr/textAppearanceListItemSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_custom_dashboard"
            android:layout_width="120dp"
            android:layout_height="72dp"
            android:background="@drawable/custom_preference_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/card_custom_dashboard_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/custom_dashboard_title"
                android:textAlignment="center"
                android:textAppearance="?android:attr/textAppearanceListItemSecondary" />
        </LinearLayout>
    </LinearLayout>
</HorizontalScrollView>
