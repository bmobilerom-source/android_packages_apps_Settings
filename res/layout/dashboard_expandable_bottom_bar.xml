<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <github.com.st235.lib_expandablebottombar.ExpandableBottomBar
        android:id="@+id/dashboard_expandable_bottom_bar"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:exb_backgroundColor="?android:attr/colorBackgroundFloating"
        app:exb_backgroundCornerRadius="24dp"
        app:exb_itemInactiveColor="?android:attr/textColorPrimary"
        app:exb_itemBackgroundCornerRadius="20dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/dashboard_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:itemIconTint="@color/dashboard_bottom_nav_label"
        app:itemTextColor="@color/dashboard_bottom_nav_label"
        app:labelVisibilityMode="labeled" />

</FrameLayout>
