<LinearLayout
    android:layout_width="fill_parent"
    android:background="@android:color/transparent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16.0dip"
    android:layout_marginEnd="8.0dip"
    android:layout_marginVertical="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <com.google.android.material.card.MaterialCardView
        android:layout_width="fill_parent"
        android:layout_height="180dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="26.0dip"
        app:cardElevation="0.0dip"
        app:rippleColor="?android:attr/colorControlHighlight">
        
        <RelativeLayout
            android:padding="16.0dip"
            android:layout_width="fill_parent"
            android:layout_height="180.0dip">
            
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true">
                
                <androidx.preference.internal.PreferenceImageView
                    android:id="@android:id/icon"
                    android:background="@drawable/adaptive_icon_shape"
                    android:padding="8.0dip"
                    android:layout_width="43.0dip"
                    android:layout_height="43.0dip"
                    android:tint="?android:colorPrimary"
                    android:backgroundTint="?android:colorAccent" />
                    
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
                    
                <ImageView
                    android:gravity="end|center"
                    android:background="@drawable/adaptive_icon_shape"
                    android:layout_width="28.0dip"
                    android:layout_height="28.0dip"
                    android:src="@drawable/afterlabs_icon_next"
                    android:tint="?android:textColorPrimary"
                    android:backgroundTint="?android:colorBackground" />
            </LinearLayout>
            
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="8dp">
                
                <TextView
                    android:textSize="18.0sp"
                    android:textStyle="bold"
                    android:textColor="?android:textColorPrimary"
                    android:id="@android:id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:singleLine="true" />
                    
                <TextView
                    android:textSize="14.0sp"
                    android:textColor="?android:textColorSecondary"
                    android:id="@android:id/summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:maxLines="4" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
