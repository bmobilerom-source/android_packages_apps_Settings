<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="224dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/adaptive_preference_card_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Placeholder rectangles area -->
    <LinearLayout
        android:id="@+id/toggles_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginBottom="11dp">
        
        <!-- Two small light blue rectangles at top -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <View
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/placeholder_rect_light_blue" />
            <View
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/placeholder_rect_light_blue" />
        </LinearLayout>
        
        <!-- Two small dark gray rectangles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <View
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/placeholder_rect_dark_gray" />
            <View
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/placeholder_rect_dark_gray" />
        </LinearLayout>
        
        <!-- Larger dark gray rectangle in middle -->
        <View
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/placeholder_rect_dark_gray" />
        
        <!-- Another large dark gray rectangle -->
        <View
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:background="@drawable/placeholder_rect_dark_gray" />
    </LinearLayout>

    <!-- Aurora Store Button - light blue oval -->
    <LinearLayout
        android:id="@+id/system_basic_defaults_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:background="@drawable/button_oval_light_blue"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="8dp">

        <TextView
            android:id="@+id/system_basic_defaults_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?android:textColorPrimary"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>




