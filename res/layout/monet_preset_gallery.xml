<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <!-- Title -->
    <TextView
        android:id="@+id/monet_preset_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/monet_color_presets_title"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:padding="24dp"
        android:gravity="center" />

    <!-- Grid RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/monet_preset_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:scrollbars="vertical" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="end">

        <Button
            android:id="@+id/monet_preset_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel"
            android:layout_marginEnd="8dp"
            style="?android:buttonStyle" />

        <Button
            android:id="@+id/monet_preset_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/monet_color_presets_apply"
            style="?android:buttonBarPositiveButtonStyle" />

    </LinearLayout>

</LinearLayout>